{
  "manifest_version": 3,
  "name": "FillBARS Card — назначения и дневники",
  "version": "5.2.6",
  "description": "Назначения и дневники МИС БАРС: шаблоны, предпросмотр и последовательное заполнение.",
  "minimum_chrome_version": "112",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "./badger.png",
      "48": "./badger.png",
      "128": "./badger.png"
    }
  }
}
